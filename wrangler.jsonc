{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skillcert",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "routes": [
    {
      "pattern": "skillcert.vaionyxsolutions.online",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
